{
  "manifest_version": 3,
  "name": "Tidy Trail – Hide Search & Site History",
  "version": "3.1",
  "minimum_chrome_version": "102",
  "description": "Keeps your history tidy: removes searches and chosen sites as you browse, right away, after a delay or when you close the tab.",
  "permissions": [
    "history",
    "storage",
    "alarms",
    "browsingData",
    "downloads",
    "bookmarks",
    "tabs",
    "contextMenus"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tidy Trail",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "clean-now": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "Clean history now"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "short_name": "Tidy Trail"
}
